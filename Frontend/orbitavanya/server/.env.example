# Copy this file to .env and fill in real values. Never commit .env to git.

# Mongo connection (your local scraper DB)
MONGO_URI=mongodb://127.0.0.1:27017/company_scraper

# Port the auth API listens on
PORT=5050

# Where the React app runs, for CORS
CLIENT_URL=http://localhost:5173

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=helloworldthedayisveryboringandnotinteresting
JWT_EXPIRES_IN=7d

# Gmail SMTP for sending OTP emails.
# IMPORTANT: do NOT put your normal Gmail password here.
# 1. Turn on 2-Step Verification on the Google account: https://myaccount.google.com/security
# 2. Create an "App Password" here: https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password as SMTP_PASS below.
SMTP_USER=prasannadhamal982005@gmail.com
SMTP_PASS=uddlnnhflcfbojj
SMTP_FROM="OrbitAvanya <prasannadhamal982005@gmail.com>"

# OTP behaviour
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# ---------------------------------------------------------------
# Video meeting providers — pick Jitsi (default, no keys needed),
# Zoom, or Google Meet per-meeting from the Meetings page.
# ---------------------------------------------------------------

# Zoom Server-to-Server OAuth app — from https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google OAuth (Calendar/Meet) — from https://console.cloud.google.com
# GOOGLE_REDIRECT_URI must exactly match an Authorized redirect URI
# configured on this OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/integrations/google/callback
