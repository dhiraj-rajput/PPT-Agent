# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ppt_agent_db

# LLM Providers Configuration (e.g. OpenAI, Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Search API Configuration (e.g. Tavily, SerpAPI)
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# LinkedIn Scraping Credentials / Session Cookie (if using custom scraper)
LINKEDIN_LI_AT=your_li_at_cookie_here

# Scraping API configuration (if using Firecrawl or Jina)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
