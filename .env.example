# ============================================================
# PPT-Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/company_scraper
MONGO_DB_NAME=company_scraper

# Port the FastAPI backend listens on
PORT=5050

# ------------------------------------------------------------
# Search API — Tavily (for company name → LinkedIn URL resolution)
# Get your key at: https://app.tavily.com
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# LinkedIn Authenticated Scraping (Optional — Layer 3)
# ------------------------------------------------------------
LINKEDIN_LI_AT=your_li_at_session_cookie_here

# ------------------------------------------------------------
# Scraping Behavior Configuration
# Delay range in seconds between scraping requests (randomized)
# to simulate human browsing and avoid detection.
# ------------------------------------------------------------
SCRAPE_DELAY_MIN_SECONDS=3
SCRAPE_DELAY_MAX_SECONDS=8
BROWSER_HEADLESS=true

SAM_GOV_API_KEY=your_sam_gov_api_key_here
FORCE_MOCK_SAM_GOV=false

# ------------------------------------------------------------
# Optional: Other Scraping API Services
# ------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------
# Ollama LLM Configuration (free cloud model)
# ------------------------------------------------------------
OLLAMA_HOST=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL_FALLBACKS=gemma4:31b-cloud,gemma3:27b,llama3.1:8b
OLLAMA_TEMPERATURE=0.1
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ------------------------------------------------------------
# Master AI / rule-based switch — applies to every agent in the project
# ------------------------------------------------------------
AI_MODE=auto

# Optional per-agent overrides (leave blank to just use AI_MODE above)
WEBSITE_AGENT_MODE=
LINKEDIN_AGENT_MODE=
SEARCH_AGENT_MODE=
COMPACTOR_MODE=
RFP_PARSER_MODE=
RFP_RESPONSE_MODE_AI=
BIDFORGE_MODE=

# OCR fallback for scanned/image-only RFP PDFs
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40

# ------------------------------------------------------------
# JWT Authentication (replaces Node.js auth server)
# ------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# OTP (One-Time Password) settings
# ------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# ------------------------------------------------------------
# SMTP Email Configuration (for OTP / invite / task / meeting emails)
# ------------------------------------------------------------
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="OrbitAvanya <your_email@gmail.com>"

# Frontend URL (used in email links)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# Zoom Integration (optional — Jitsi is used as fallback)
# Create a Server-to-Server OAuth app at: https://marketplace.zoom.us
# ------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ------------------------------------------------------------
# Google Meet / Calendar Integration (optional — Jitsi fallback)
# Create OAuth credentials at: https://console.cloud.google.com
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/integrations/google/callback
