# -----------------------------------------------------------------------
# OrbitAvanya backend — environment configuration
# -----------------------------------------------------------------------
# Copy this file to ".env" in the project root (same folder as server.py)
# and fill in real values. ".env" is gitignored so it will never be
# committed or shared — that's also why it isn't in this zip/repo and why
# the app currently can't send mail: there is no .env at all yet.
#
# After editing .env, restart the backend (uvicorn/python server.py) for
# changes to take effect.
# -----------------------------------------------------------------------

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ppt_agent_db

# ---- Auth ----
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-use-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ---- SMTP (outgoing mail — required for campaigns, OTP, invites, etc.) ----
# Works with any SMTP provider. Defaults below are for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-address@gmail.com

# --- Gmail-specific setup (most common source of "can't send mail") ---
# Gmail will silently reject SMTP login with your normal account password
# once 2-Step Verification is on (which is the default for most accounts).
# You need an App Password instead:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      (choose app "Mail", any device name)
#   3. Use the 16-character password Google gives you as SMTP_PASS above
#      (remove spaces). Your regular Gmail password will NOT work here.

# ---- IMAP (incoming mail — required to detect replies) ----
# Leave IMAP_HOST empty to auto-detect from SMTP_HOST (Gmail/Outlook/Yahoo/
# Zoho are recognized automatically). Set it explicitly for anything else,
# e.g. a company mail server.
IMAP_HOST=
IMAP_PORT=993
# Gmail also requires IMAP to be enabled on the account:
#   Gmail settings -> "See all settings" -> Forwarding and POP/IMAP ->
#   Enable IMAP -> Save changes.
# The same App Password above (not your normal password) is used for IMAP too.

# ---- URLs ----
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5050

# ---- Server ----
PORT=5050
ENV=dev

# ---- Optional integrations (leave blank if unused) ----
SAM_GOV_API_KEY=
TAVILY_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- OCR (Cloud-based, zero local computation) ----
# Free OCR API — 25,000 requests/month (get key at https://ocr.space/ocrapi/freekey)
# Without a key, demo mode is used (500 req/day, no registration needed).
OCR_SPACE_API_KEY=

# ---- AI Provider & BidForge Strict Debug Mode ----
# Set BIDFORGE_STRICT_AI=true while debugging so AI errors raise immediately
# instead of silently falling back to generic rule-based templates.
BIDFORGE_STRICT_AI=true

# Preferred order of AI providers (e.g. gemini,openrouter,ollama)
AI_PROVIDER_ORDER=gemini,openrouter,ollama

# ---- OpenRouter model selection ----
# Primary and fallback models for document generation (paid/reliable models recommended over :free).
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2411,openrouter/auto

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
