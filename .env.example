# ============================================================
# PPT-Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# MongoDB Configuration
# Local development:  mongodb://localhost:27017/
# Atlas (production): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
# ------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ppt_agent_db



# ------------------------------------------------------------
# Search API — Tavily (for company name → LinkedIn URL resolution)
# Get your key at: https://app.tavily.com
# Free tier: 1,000 searches/month
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# LinkedIn Authenticated Scraping (Optional — Layer 3)
# How to get li_at cookie: See linkedin/GUIDE.md
# WARNING: Use a burner/secondary account only. Never your primary account.
# ------------------------------------------------------------
LINKEDIN_LI_AT=your_li_at_session_cookie_here

# ------------------------------------------------------------
# Scraping Behavior Configuration
# Delay range in seconds between scraping requests (randomized)
# to simulate human browsing and avoid detection.
# ------------------------------------------------------------
SCRAPE_DELAY_MIN_SECONDS=3
SCRAPE_DELAY_MAX_SECONDS=8
BROWSER_HEADLESS=true


SAM_GOV_API_KEY=your_sam_gov_api_key_here

# ------------------------------------------------------------
# Optional: Other Scraping API Services
# ------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------
# Website Crawler Configuration
# How many pages to crawl per company website (max)
# ------------------------------------------------------------
MAX_CRAWL_PAGES=15
CRAWL_TIMEOUT=30000

# ------------------------------------------------------------
# MongoDB Atlas (production) — swap MONGO_URI to this format:
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave as localhost for local development.
# ------------------------------------------------------------


