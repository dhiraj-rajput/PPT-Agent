# ============================================================
# PPT-Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# MongoDB Configuration
# Local development:  mongodb://localhost:27017/
# Atlas (production): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
# ------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ppt_agent_db

# ------------------------------------------------------------
# Search API — Tavily (for company name → LinkedIn URL resolution)
# Get your key at: https://app.tavily.com
# Free tier: 1,000 searches/month
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# LinkedIn Authenticated Scraping (Optional — Layer 3)
# How to get li_at cookie: See linkedin/GUIDE.md
# WARNING: Use a burner/secondary account only. Never your primary account.
# ------------------------------------------------------------
LINKEDIN_LI_AT=your_li_at_session_cookie_here

# ------------------------------------------------------------
# Scraping Behavior Configuration
# Delay range in seconds between scraping requests (randomized)
# to simulate human browsing and avoid detection.
# ------------------------------------------------------------
SCRAPE_DELAY_MIN_SECONDS=3
SCRAPE_DELAY_MAX_SECONDS=8
BROWSER_HEADLESS=true

SAM_GOV_API_KEY=your_sam_gov_api_key_here

# ------------------------------------------------------------
# Optional: Other Scraping API Services
# ------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------
# Website Crawler Configuration
# How many pages to crawl per company website (max)
# crawl4ai is used as the primary crawler with Playwright fallback
# ------------------------------------------------------------
MAX_CRAWL_PAGES=15
CRAWL_TIMEOUT=30000

# ------------------------------------------------------------
# MongoDB Atlas (production) — swap MONGO_URI to this format:
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave as localhost for local development.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Ollama LLM Configuration (free cloud model)
# gemma4:31b-cloud is free via Ollama cloud
# Leave OLLAMA_HOST empty to use local Ollama at localhost:11434
# ------------------------------------------------------------
OLLAMA_HOST=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL_FALLBACKS=gemma4:31b-cloud,gemma3:27b,llama3.1:8b
OLLAMA_TEMPERATURE=0.1
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# Master AI / rule-based switch — applies to every agent in the project
# (website, linkedin, external search, compactor, RFP parsing, RFP
# response / BidForge document generation).
#   ai / auto   -> try Ollama Cloud first, auto-fallback to rules on
#                  failure or 429 rate-limit
#   rule_based  -> never call AI, rule-based logic only
# --------------------------------------------------------------------
AI_MODE=auto

# Optional per-agent overrides (leave blank to just use AI_MODE above)
WEBSITE_AGENT_MODE=
LINKEDIN_AGENT_MODE=
SEARCH_AGENT_MODE=
COMPACTOR_MODE=
RFP_PARSER_MODE=
RFP_RESPONSE_MODE_AI=
BIDFORGE_MODE=

# OCR fallback for scanned/image-only RFP PDFs
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40

# ------------------------------------------------------------
# JWT Authentication (replaces Node.js auth server)
# Use a long random string for JWT_SECRET (min 32 chars)
# ------------------------------------------------------------
JWT_SECRET=change-me-use-a-long-random-secret-min-32-chars
JWT_EXPIRES_DAYS=7

# ------------------------------------------------------------
# OTP (One-Time Password) settings
# ------------------------------------------------------------
OTP_TTL_MINUTES=10

# ------------------------------------------------------------
# SMTP Email Configuration (for OTP / invite / task / meeting emails)
# Gmail example — use an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=OrbitAvanya <your_email@gmail.com>

# Frontend URL (used in email links)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# Zoom Integration (optional — Jitsi is used as fallback)
# Create a Server-to-Server OAuth app at: https://marketplace.zoom.us
# ------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ------------------------------------------------------------
# Google Meet / Calendar Integration (optional — Jitsi fallback)
# Create OAuth credentials at: https://console.cloud.google.com
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ------------------------------------------------------------
# RFP Auto-Respond (AI mode override for the RFP→Proposal pipeline)
# Uses the same AI_MODE fallback chain as the rest of the project.
# Override here only if you want a different mode for RFP Auto-Respond.
# ------------------------------------------------------------
RFP_RESPOND_MODE=
