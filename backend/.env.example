# -----------------------------------------------------------------------
# OrbitAvanya backend — environment configuration
# -----------------------------------------------------------------------
# Copy this file to ".env" in the project root (same folder as server.py)
# and fill in real values. ".env" is gitignored so it will never be
# committed or shared — that's also why it isn't in this zip/repo and why
# the app currently can't send mail: there is no .env at all yet.
#
# After editing .env, restart the backend (uvicorn/python server.py) for
# changes to take effect.
# -----------------------------------------------------------------------

# ---- Environment / deployment mode ----
# "dev"  = uvicorn auto-reload + DEBUG_OTP
# "prod" = production / cPanel deployment (no auto-reload)
ENV=dev

# ---- Python executable (for research subprocess) ----
# Leave blank on localhost — auto-detects from sys.executable.
# On cPanel set to the full venv path, e.g.:
# PYTHON_PATH=/home/USERNAME/virtualenv/APPDIR/3.11/bin/python3.11
PYTHON_PATH=

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ppt_agent_db


# ---- Auth ----
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-use-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ---- SMTP (outgoing mail — required for campaigns, OTP, invites, etc.) ----
# Works with any SMTP provider (Gmail, cPanel Webmail, Mailgun, SendGrid, etc.).
# For cPanel / Custom Host: set SMTP_HOST to your mail server (e.g. mail.avanyatech.com or s13429.bom1.stableserver.net)
# For Gmail: set SMTP_HOST=smtp.gmail.com and use a 16-character App Password.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=your-address@yourdomain.com
SMTP_PASS=your-password-or-16-char-app-password
SMTP_FROM=your-address@yourdomain.com

# ---- IMAP (incoming mail — required to detect replies) ----
# Set IMAP_HOST to your IMAP server (e.g. mail.avanyatech.com or s13429.bom1.stableserver.net)
# Or leave empty to auto-detect if using Gmail/Outlook/Yahoo/Zoho.
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993

# ---- URLs ----
CLIENT_URL=https://avanyatech.com
API_BASE_URL=https://avanyatech.com/api
CORS_ORIGINS=https://avanyatech.com,https://avanyatech.com/api,http://localhost:5173

# ---- Server ----
PORT=5050
ENV=prod

# ---- Optional integrations (leave blank if unused) ----
SAM_GOV_API_KEY=
TAVILY_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- OCR (Cloud-based, zero local computation) ----
# Free OCR API — 25,000 requests/month (get key at https://ocr.space/ocrapi/freekey)
# Without a key, demo mode is used (500 req/day, no registration needed).
OCR_SPACE_API_KEY=

# ---- AI Provider & BidForge Strict Debug Mode ----
# Set BIDFORGE_STRICT_AI=true while debugging so AI errors raise immediately
# instead of silently falling back to generic rule-based templates.
BIDFORGE_STRICT_AI=true

# Preferred order of AI providers (e.g. gemini,openrouter,ollama)
AI_PROVIDER_ORDER=gemini,openrouter,ollama

# ---- OpenRouter model selection ----
# Primary and fallback models for document generation (paid/reliable models recommended over :free).
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2411,openrouter/auto

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
