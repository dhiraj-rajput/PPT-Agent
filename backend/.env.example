# Core database & config
MONGO_URI=mongodb://localhost:27017/ppt_agent
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=ppt_agent

# Auth & JWT Security
JWT_SECRET=replace_this_with_a_secure_random_32_character_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
OTP_TTL_MINUTES=10

# Server & CORS Config
PORT=5050
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5050

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME="OrbitAvanya"

# Optional External API Keys
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
SAM_GOV_API_KEY=your_sam_gov_api_key
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key
